---
layout: default
---
<div class="post about-page">
  <div class="about-layout">
    <aside class="about-sidebar" aria-label="Profile">
      {% if page.profile %}
        <div class="about-profile">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: 992px) 220px, (min-width: 576px) 30vw, 60vw{% endcapture %}
            {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image cache_bust=true %}
          {% endif %}
        </div>
      {% endif %}

      <h1 class="about-sidebar-title">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>

      {% if page.subtitle %}
        <p class="about-sidebar-subtitle">{{ page.subtitle }}</p>
      {% endif %}

      <div class="about-sidebar-links" aria-label="Social links">
        <a href="mailto:lhl@pku.edu.cn" title="Email">
          <i class="fa-solid fa-envelope"></i>
          <span>lhl@pku.edu.cn</span>
        </a>
        <a href="https://scholar.google.com/citations?user=ri-c_10AAAAJ&hl=en" title="Google Scholar">
          <i class="ai ai-google-scholar"></i>
          <span>Google Scholar</span>
        </a>
        <a href="https://www.semanticscholar.org/author/Hongliang-Lu/2346069654" title="Semantic Scholar">
          <i class="ai ai-semantic-scholar"></i>
          <span>Semantic Scholar</span>
        </a>
        <a href="https://github.com/AuroraLHL" title="GitHub">
          <i class="fa-brands fa-github"></i>
          <span>GitHub</span>
        </a>
        <a href="https://www.zhihu.com/people/xin-mo-92-97" title="Zhihu">
          <i class="fa-brands fa-zhihu"></i>
          <span>Zhihu</span>
        </a>
        <a href="https://orcid.org/0009-0003-3319-2512" title="ORCID">
          <i class="ai ai-orcid"></i>
          <span>ORCID</span>
        </a>
      </div>
    </aside>

    <main class="about-main">
      <header class="post-header about-main-header">
        {% if page.subtitle %}
          <p class="desc">{{ page.subtitle }}</p>
        {% endif %}
      </header>

      <article>
        <div class="clearfix">{{ content }}</div>

        <!-- News -->
        {% if page.announcements and page.announcements.enabled %}
          <h2>
            <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
          </h2>
          {% include news.liquid limit=true %}
        {% endif %}

        <!-- Education -->
        {% if page.education %}
          <h2>education</h2>
          <div class="edu-exp-section">
            {% for edu in page.education %}
              <div class="edu-exp-item">
                <div class="edu-exp-logo">
                  {% if edu.url %}
                    <a href="{{ edu.url }}" target="_blank">
                      <img src="{{ edu.image | prepend: 'assets/img/' | relative_url }}" alt="{{ edu.institution }}">
                    </a>
                  {% else %}
                    <img src="{{ edu.image | prepend: 'assets/img/' | relative_url }}" alt="{{ edu.institution }}">
                  {% endif %}
                </div>
                <div class="edu-exp-info">
                  <div class="edu-exp-top">
                    <h3>
                      {% if edu.url %}
                        <a href="{{ edu.url }}" target="_blank">{{ edu.institution }}</a>
                      {% else %}
                        {{ edu.institution }}
                      {% endif %}
                      {% if edu.department %}
                        <span class="edu-exp-inline-meta">&middot; {{ edu.department }}</span>
                      {% endif %}
                    </h3>
                    <span class="edu-exp-date">{{ edu.year_start }} — {{ edu.year_end }}</span>
                  </div>
                  <div class="edu-exp-detail">{{ edu.degree }}</div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <!-- Experience -->
        {% if page.experience %}
          <h2>experience</h2>
          <div class="edu-exp-section">
            {% for exp in page.experience %}
              <div class="edu-exp-item">
                <div class="edu-exp-logo">
                  {% if exp.url %}
                    <a href="{{ exp.url }}" target="_blank">
                      <img src="{{ exp.image | prepend: 'assets/img/' | relative_url }}" alt="{{ exp.company }}">
                    </a>
                  {% else %}
                    <img src="{{ exp.image | prepend: 'assets/img/' | relative_url }}" alt="{{ exp.company }}">
                  {% endif %}
                </div>
                <div class="edu-exp-info">
                  <div class="edu-exp-top">
                    <h3>
                      {% if exp.url %}
                        <a href="{{ exp.url }}" target="_blank">{{ exp.company }}</a>
                      {% else %}
                        {{ exp.company }}
                      {% endif %}
                      {% if exp.team %}
                        <span class="edu-exp-inline-meta">&middot; {{ exp.team }}</span>
                      {% endif %}
                    </h3>
                    <span class="edu-exp-date">{{ exp.year_start }} — {{ exp.year_end }}</span>
                  </div>
                  <div class="edu-exp-detail">{{ exp.role }}</div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <!-- Selected papers -->
        {% if page.selected_papers %}
          <h2>
            <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
          </h2>
          {% include selected_papers.liquid %}
        {% endif %}

        <!-- Latest posts -->
        {% if page.latest_posts and page.latest_posts.enabled %}
          <h2>
            <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
          </h2>
          {% include latest_posts.liquid %}
        {% endif %}

        <!-- Social -->
        {% if page.social %}
          <div class="social">
            <div class="contact-icons">{% include social.liquid %}</div>

            <div class="contact-note">{{ site.contact_note }}</div>
          </div>
        {% endif %}

        {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
          {% include newsletter.liquid center=true %}
        {% endif %}
      </article>
    </main>
  </div>
</div>
